name: "screetc_pinn"
platform: "pytorch_libtorch"
max_batch_size: 64

input [
  {
    name: "domain_points"
    data_type: TYPE_FP32
    dims: [ -1, 3 ] # Dynamic array of anonymized 3D surface vertices [X, Y, Z]
  },
  {
    name: "fluid_parameters"
    data_type: TYPE_FP32
    dims: [ 2 ] # [Inlet Velocity MPS, Temperature Kelvin]
  }
]

output [
  {
    name: "velocity_vectors"
    data_type: TYPE_FP32
    dims: [ -1, 3 ] # Returned dynamic velocity gradients [U_x, U_y, U_z]
  },
  {
    name: "pressure_fields"
    data_type: TYPE_FP32
    dims: [ -1, 1 ] # Predicted local structural surface pressure scalar values
  }
]

instance_group [
  {
    count: 2
    kind: KIND_GPU # Pin deployment instances directly across available Tensor Core silicons
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 500
}
